{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "WebWorker"],
    "types": [],
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "scripts/**/*.mjs"]
}
